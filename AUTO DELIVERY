local running = false

-- Fungsi mencari "deliverywaypoint" secara ringan
local function findDeliveryWaypoint()
	for _, obj in ipairs(Workspace:GetChildren()) do
		local cleanName = string.lower(obj.Name):gsub("[%s_]", "")
		if cleanName == "deliverywaypoint" then
			if obj:IsA("BasePart") then
				return obj.Position
			elseif obj:IsA("Model") and obj.PrimaryPart then
				return obj.PrimaryPart.Position
			end
		end
	end
	return nil
end

-- Fungsi scan super cepat & anti-lag (hanya ambil part yang berjarak dekat dengan posisi motor saat ini)
local function getNearbyTrailPoints(currentPos)
	local orbPoints = {}
	
	-- Batasi pencarian hanya dalam radius 600 stud dari posisi motor agar tidak membebani CPU
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local cleanName = string.lower(obj.Name):gsub("[%s_]", ""):gsub("0", "o")
			if cleanName:find("trailorb") then
				local pos = obj.Position
				if (pos - currentPos).Magnitude < 600 then
					table.insert(orbPoints, pos)
				end
			end
		end
	end

	if #orbPoints == 0 then return {} end

	-- Urutkan secara estafet lokal (max 150 titik terdepan)
	local orderedPath = {}
	local currentPoint = currentPos

	for i = 1, math.min(150, #orbPoints) do
		if #orbPoints == 0 then break end
		
		local nearestIdx = 1
		local shortestDist = math.huge

		for idx, pos in ipairs(orbPoints) do
			local dist = (pos - currentPoint).Magnitude
			if dist < shortestDist and dist < 70 then
				shortestDist = dist
				nearestIdx = idx
			end
		end

		-- Jika tidak ketemu dalam radius dekat, ambil sisa terdekat
		if shortestDist == math.huge then
			for idx, pos in ipairs(orbPoints) do
				local dist = (pos - currentPoint).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					nearestIdx = idx
				end
			end
		end

		table.insert(orderedPath, orbPoints[nearestIdx])
		currentPoint = orbPoints[nearestIdx]
		table.remove(orbPoints, nearestIdx)
	end

	return orderedPath
end

local function startLagFreeRide()
	local seat = humanoid.SeatPart
	if not seat then
		toggleButton.Text = "RE RUN SCRIPT"
		toggleButton.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
		task.wait(2)
		toggleButton.Text = "Lag-Free Trail: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		running = false
		return
	end

	local vehicleModel = seat.Parent
	if not vehicleModel or vehicleModel == character or vehicleModel == Workspace then
		vehicleModel = seat
	end

	toggleButton.Text = "AUTO DRIVE: ON"
	toggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)

	task.spawn(function()
		while running do
			if not seat.Parent then break end
			local currentPos = seat.Position
			local deliveryPos = findDeliveryWaypoint()

			-- Jika sudah dekat dengan deliverywaypoint (< 50 stud), langsung potong kompas ke finish
			if deliveryPos and (deliveryPos - currentPos).Magnitude < 50 then
				while running do
					if not seat.Parent then break end
					currentPos = seat.Position
					local finalPos = findDeliveryWaypoint()

					if not finalPos or (finalPos - currentPos).Magnitude < 15 then
						running = false
						toggleButton.Text = "SUCCESS ✅!"
						toggleButton.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
						task.wait(2)
						toggleButton.Text = "AUTO DRIVE: OFF"
						toggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
						break
					end

					local flatTarget = Vector3.new(finalPos.X, currentPos.Y, finalPos.Z)
					local direction = (flatTarget - currentPos)
					local moveDir = direction.Unit
					local speed = 4.5
					local newPos = currentPos + (moveDir * speed)
					local lookTarget = Vector3.new(finalPos.X, newPos.Y, finalPos.Z)

					if vehicleModel:IsA("Model") and vehicleModel.PrimaryPart then
						vehicleModel:SetPrimaryPartCFrame(CFrame.lookAt(newPos, lookTarget))
					else
						seat.CFrame = CFrame.lookAt(newPos, lookTarget)
					end

					task.wait(0.03)
				end
				break
			end

			-- Ambil jalur trail lokal di sekitar motor secara dinamis (ringan & tidak bikin lag)
			local trailPath = getNearbyTrailPoints(currentPos)

			if #trailPath == 0 then
				toggleButton.Text = "Mencari Trail..."
				task.wait(0.2)
				continue
			end

			-- Ikuti titik-titik terdekat tersebut satu per satu
			for _, waypointPos in ipairs(trailPath) do
				if not running or not seat.Parent then break end

				repeat
					if not running or not seat.Parent then break end
					currentPos = seat.Position

					-- Cek ulang jarak ke finish
					local checkDelivery = findDeliveryWaypoint()
					if checkDelivery and (checkDelivery - currentPos).Magnitude < 50 then
						break
					end

					local flatTarget = Vector3.new(waypointPos.X, currentPos.Y, waypointPos.Z)
					local direction = (flatTarget - currentPos)
					local dist = direction.Magnitude

					if dist < 10 then
						break -- Lanjut ke titik berikutnya
					else
						local moveDir = direction.Unit
						local speed = 4.5
						local newPos = currentPos + (moveDir * speed)
						local lookTarget = Vector3.new(waypointPos.X, newPos.Y, waypointPos.Z)

						if vehicleModel:IsA("Model") and vehicleModel.PrimaryPart then
							vehicleModel:SetPrimaryPartCFrame(CFrame.lookAt(newPos, lookTarget))
						else
							seat.CFrame = CFrame.lookAt(newPos, lookTarget)
						end
					end

					task.wait(0.03)
				until (waypointPos - seat.Position).Magnitude < 10 or not running
			end

			-- Beri sedikit jeda per siklus agar CPU tidak bekerja berlebihan (mencegah lag patah-patah)
			task.wait(0.05)
		end
	end)
end

toggleButton.MouseButton1Click:Connect(function()
	if not running then
		running = true
		startLagFreeRide()
	else
		running = false
		toggleButton.Text = "AUTO DRIVE: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	end
end)
