-- ===== Kontrol jalan (hook WorldMenu.isDown) =====
local AutoInput = {active=false, left=false, right=false, jump=false, down=false}
local OrigIsDown, MenuMod
do
    local okM, mod = pcall(function() return require(P.PlayerGui:WaitForChild("GameGui", 5):WaitForChild("WorldMenu", 5)) end)
    if okM and type(mod) == 'table' and type(rawget(mod, 'isDown')) == 'function' then
        local env = type(getgenv) == 'function' and getgenv() or _G
        local cur = rawget(mod, 'isDown')
        if env.__LD_WRAP and env.__LD_WRAP == cur and env.__LD_ORIG then cur = env.__LD_ORIG end
        OrigIsDown, MenuMod = cur, mod
        local function wrap(saved, key, ...)
            if AutoInput.active then
                if key == 'keyLeft' then return AutoInput.left end
                if key == 'keyRight' then return AutoInput.right end
                if key == 'keyJump' then return AutoInput.jump end
                if key == 'keyDown' then return AutoInput.down end
            end
            return OrigIsDown(saved, key, ...)
        end
        mod.isDown = wrap
        env.__LD_WRAP, env.__LD_ORIG = wrap, cur
    end
end

-- ===== Cari fungsi game =====
local GF = {}
local getconsts = (debug and debug.getconstants) or getconstants
local function hasConsts(fn, want)
    if not getconsts then return false end
    if islclosure and not islclosure(fn) then return false end
    local ok, c = pcall(getconsts, fn)
    if not ok or type(c) ~= 'table' then return false end
    local hit = {}
    for _, k in pairs(c) do if want[k] then hit[want[k]] = true end end
    return hit
end
local function isSetTileFn(fn)
    local h = hasConsts(fn, {tile='send', SetTile='send', placedAt='placed', flips='flips'})
    return h and h.send and h.placed and h.flips
end
local function isPunchFn(fn)
    local h = hasConsts(fn, {['Empty the Vending Machine first!']='vend', newCrack='mark', HarvestProvider='mark'})
    return h and h.vend and h.mark
end
local function isGameFn(fn)
    if fn == isSetTileFn or fn == isPunchFn or fn == hasConsts then return false end
    local ok, s = pcall(debug.info, fn, 's')
    if ok and type(s) == 'string' and s ~= '' and not string.find(s, 'GameGui', 1, true) then return false end
    return true
end
local function findGameFns()
    if (GF.punch and GF.setTile) or not (getgc and getconsts) then return end
    for _, v in ipairs(getgc(true)) do
        if type(v) == 'function' and isGameFn(v) then
            if not GF.setTile and isSetTileFn(v) then GF.setTile = v
            elseif not GF.punch and isPunchFn(v) then GF.punch = v end
            if GF.setTile and GF.punch then break end
        end
    end
end

