local runToggles, resetting = {}, false
onStopUI = function()
    if resetting then return end
    resetting = true
    for _, t in pairs(runToggles) do pcall(function() t:Set(false) end) end
    resetting = false
end
local function startRun(mode)
    if mode ~= 'Clear' and mode ~= 'DF' and not next(targets) then notify("Peringatan", "Pilih tile di Grid dulu!"); return false end
    local ok, err = pcall(function() bindObservations(); findGameFns(); autoPosition() end)
    if not ok then notify("Gagal", tostring(err), 4); return false end
    cfg.mode = mode
    active = true; stats.started = os.clock()
    notify("LITEDIRT", "Mulai: " .. mode)
    return true
end
local function runToggle(section, mode, title)
    local t
    t = section:Toggle({
        Title = title,
        Value = false,
        Callback = function(on)
            if resetting then return end
            if on then
                if active then
                    notify("Peringatan", "Matikan fitur yang lain dulu", 2)
                    resetting = true; pcall(function() t:Set(false) end); resetting = false
                    return
                end
                if not startRun(mode) then
                    resetting = true; pcall(function() t:Set(false) end); resetting = false
                end
            else
                stop("Dihentikan")
            end
        end,
    })
    runToggles[mode] = t
    return t
end

