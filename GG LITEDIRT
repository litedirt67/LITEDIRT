local function pressSlot(n)
    local k = slotKeys[n]
    if not k then return end
    VirtualInputManager:SendKeyEvent(true, k, false, game)
    VirtualInputManager:SendKeyEvent(false, k, false, game)
end
local function clickTile(dx, dy)
    local pos = origin + Vector2.new(dx * step, dy * step)
    last = pos
    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
end
local function sortedTargets()
    local list = {}
    for _, t in pairs(targets) do list[#list+1] = t end
    table.sort(list, function(a, b)
        if a[2] ~= b[2] then return a[2] < b[2] end
        return a[1] < b[1]
    end)
    return list
end
local function putOne(t) pressSlot(cfg.blockSlot); clickTile(t[1], t[2]); task.wait(cfg.delay) end
local function brkOne(t)
    pressSlot(cfg.fistSlot)
    for _ = 1, cfg.hits do
        if not (alive and active) then return end
        clickTile(t[1], t[2]); task.wait(cfg.delay)
    end
end
local function put(list)
    pressSlot(cfg.blockSlot)
    for _, t in ipairs(list) do
        if not (alive and active) then return end
        clickTile(t[1], t[2]); task.wait(cfg.delay)
    end
end
local function brk(list)
    pressSlot(cfg.fistSlot)
    for _, t in ipairs(list) do
        if not (alive and active) then return end
        brkOne(t)
    end
end
local function waitSec(sec)
    local t0 = os.clock()
    while alive and active and os.clock() - t0 < sec do task.wait(.25) end
end

-- Clear: sapu seluruh world dari kiri/kanan, ular (baris berikutnya arah berlawanan)
local function clearWorld()
    local w = Path.sample().w
    local leftFirst = (cfg.clearDir == 'KIRI')
    local skipped = {}
    for y = 0, w.h - 1 do
        if not (alive and active) then return end
        local ltr = leftFirst
        if y % 2 == 1 then ltr = not ltr end
        local x0, x1, dx = 0, w.w - 1, 1
        if not ltr then x0, x1, dx = w.w - 1, 0, -1 end
        for x = x0, x1, dx do
            if not (alive and active) then return end
            local row = w.fg[y]
            local id = (row and row[x]) or 0
            if id ~= 0 and not skipped[x..':'..y] then
                local ok = Path.goCell(x, y, 1, 20)
                if ok and (alive and active) then
                    autoPosition()
                    local s = Path.sample()
                    local px, py = math.floor(s.x), math.floor(s.y - .475)
                    pressSlot(cfg.fistSlot)
                    local tries = 0
                    while alive and active and tries < 40 do
                        local r = w.fg[y]
                        if not r or (r[x] or 0) == 0 then break end
                        clickTile(x - px, y - py); task.wait(cfg.delay)
                        tries += 1
                    end
                    if tries >= 40 then skipped[x..':'..y] = true end
                else
                    skipped[x..':'..y] = true -- tidak terjangkau: lewati
                end
            end
        end
    end
    stop("Clear selesai (" .. tostring(next(skipped) and "ada tile dilewati" or "bersih") .. ")")
end

-- Auto DF: bangun baris dirt tiap 2 tile, platform di kedua ujung, zigzag.
-- Hanya membaca/menaruh tile di dekat player (aman dari batas render).
local function dfBuild()
    local w = Path.sample().w
    local function tileAt(x, y) local r = w.fg[y]; return (r and r[x]) or 0 end
    local L = cfg.dfLeft
    local R = (cfg.dfRight > 0) and cfg.dfRight or (w.w - 2)
    local d = (cfg.dfStart == 'KIRI') and 1 or -1
    local gapY = math.floor(Path.sample().y - .475) -- baris jalan pertama = posisi player sekarang
    local placed, failed = 0, 0
    local function place(tx, ty, slot)
        for _ = 1, 3 do
            if not (alive and active) then return false end
            if tileAt(tx, ty) ~= 0 then return true end
            autoPosition()
            local s = Path.sample()
            local px, py = math.floor(s.x), math.floor(s.y - .475)
            pressSlot(slot)
            clickTile(tx - px, ty - py)
            task.wait(math.max(cfg.delay, .15))
            if tileAt(tx, ty) ~= 0 then placed += 1; return true end
        end
        failed += 1
        return false
    end
    local function dropTo(targetY)
        AutoInput.active = true; AutoInput.down = true
        local t0 = os.clock()
        while alive and active and os.clock() - t0 < 2.5 do
            local s = Path.sample()
            if s.grounded and math.floor(s.y - .475) >= targetY then break end
            task.wait()
        end
        AutoInput.down = false; AutoInput.active = false
    end
    while alive and active do
        local dirtY = gapY + 1
        if dirtY > cfg.dfLastRow then break end
        local x0, x1 = L, R
        if d == -1 then x0, x1 = R, L end
        if not Path.goCell(x0, gapY, 0, 25, true) then stop("DF: gagal ke ujung baris Y=" .. gapY); return end
        for x = x0, x1 - d, d do
            if not (alive and active) then return end
            local tx = x + d
            place(tx, dirtY, (tx == x1) and cfg.dfPlatSlot or cfg.blockSlot)
            if not Path.goCell(tx, gapY, 0, 15, true) then stop("DF: tertahan di X=" .. tx .. " Y=" .. gapY); return end
        end
        if dirtY + 2 > cfg.dfLastRow then break end
        place(x1, dirtY + 2, cfg.dfPlatSlot) -- platform baris berikutnya (3 tile di bawah)
        dropTo(gapY + 2)
        gapY = gapY + 2; d = -d
    end
    stats.cycles += 1
    stop(string.format("Auto DF selesai (dipasang %d, gagal %d)", placed, failed))
end

local function runOnce()
    if cfg.mode == 'Clear' then
        autoPosition(); clearWorld(); return
    end
    if cfg.mode == 'DF' then
        autoPosition(); dfBuild(); return
    end
    local list = sortedTargets()
    if #list == 0 then stop("Pilih tile dulu di grid"); return end
    autoPosition()
    if cfg.mode == 'PnB' then
        if cfg.action == 'PUT' then put(list)
        elseif cfg.action == 'BREAK' then brk(list)
        elseif cfg.action == 'INSTANT' then
            for _, t in ipairs(list) do
                if not (alive and active) then break end
                putOne(t); brkOne(t)
            end
        else put(list); brk(list) end -- CYCLING
    else -- Pabrik: panen -> break -> tanam -> tunggu
        brk(list)
        if cfg.factoryBreak then brk(list) end
        put(list)
        waitSec(cfg.growSec)
    end
    stats.cycles += 1
end

task.spawn(function()
    while alive do
        task.wait(.05)
        if active then
            local ok, err = pcall(runOnce)
            if not ok then stop("Error: " .. tostring(err)) end
        end
    end
end)

