local function inventoryBinding()
 assert(type(getgc)=='function' and debug and type(debug.getupvalues)=='function','API pembacaan inventory tidak tersedia')
 local inventoryGui=P.PlayerGui:FindFirstChild('InventoryGui')
 assert(inventoryGui,'InventoryGui belum tersedia; tunggu backpack selesai dimuat')
 local function hotbarLike(t,db)
  if type(t)~='table'then return false end
  for k,v in pairs(t)do
   if type(k)~='number' or k<1 or k>3 or k~=math.floor(k)then return false end
   if v~=false then
    local item=type(v)=='number' and rawget(db,v)
    if type(item)~='table' or item.kind=='tool' or item.kind=='cloth' then return false end
   end
  end
  return true
 end
 local binding
 for _,fn in ipairs(getgc())do
  if type(fn)=='function'then
   local ok,u=pcall(debug.getupvalues,fn)
   if ok then
    local api,db,inv,guiMatch
    for _,v in pairs(u)do
     if type(v)=='table'then
      if rawget(v,'refresh')==fn then api=v end
      local blank,dirt=rawget(v,0),rawget(v,2)
      if type(blank)=='table' and type(dirt)=='table' and dirt.name=='Dirt' then db=v end
      local valid,answer=pcall(function()return type(rawget(v,'slots'))=='table' and type(v.count)=='function' and type(v.select)=='function'end)
      if valid and answer then inv=v end
      local first=rawget(v,1)
      if type(first)=='table' then
       local button=rawget(first,'button')
       if typeof(button)=='Instance' and button:IsDescendantOf(inventoryGui)then guiMatch=true end
      end
     end
    end
    if api and db and inv and guiMatch then
     local hotbar
     if u[2]==inv and u[3]==db and hotbarLike(u[4],db)then
      hotbar=u[4]
     elseif u[4]==db and u[5]==inv and hotbarLike(u[3],db)then
      hotbar=u[3]
     else
      for _,candidateFn in ipairs(getgc())do
       if type(candidateFn)=='function'then
        local success,v=pcall(debug.getupvalues,candidateFn)
        if success and v[1]==db and hotbarLike(v[2],db) and v[3]==nil then
         local shared=false
         for _,value in pairs(u)do if value==v[2]then shared=true;break end end
         if shared then
          assert(not hotbar or hotbar==v[2],'Struktur hotbar tidak unik; binding dibatalkan')
          hotbar=v[2]
         end
        end
       end
      end
     end
     if hotbar then
      assert(not binding,'Beberapa inventory aktif ditemukan; masuk ulang world')
      binding={refresh=fn,hotbar=hotbar,db=db,inv=inv}
     end
    end
   end
  end
 end
 assert(binding,'Inventory aktif belum ditemukan. Buka backpack, tunggu sebentar, lalu coba Daftar block lagi.')
 return binding
end
ensureFarm=function(force,allowEmpty)
  local inventoryGui=P.PlayerGui:FindFirstChild('InventoryGui')
  if not farmBinding or farmBinding.gui~=inventoryGui then farmBinding=inventoryBinding();farmBinding.gui=inventoryGui end
  local b=farmBinding
  local id=requestedBlockId
  assert(id,'Pilih block dari daftar dahulu')
  local item=b.db[id]
  assert(item and type(item.hits)=='number' and item.hits>0,'Block ini tidak dapat dihancurkan dengan pukulan normal')
  if b.inv:count(id)<=0 and not allowEmpty then
   assert(active and refillFarm,'Refill belum siap; tekan ON')
   refillFarm(id)
   if not active or not alive then return end
   assert(b.inv:count(id)>0,'Refill gagal: drop block pilihan tidak tersedia')
  end
  if force or b.hotbar[1]~=id then
  local saved={b.hotbar[1],b.hotbar[2],b.hotbar[3]}
  local replacement={id}
  for i=1,3 do local v=saved[i];if v and v~=id and not table.find(replacement,v)then replacement[#replacement+1]=v end end
  for i=1,3 do b.hotbar[i]=replacement[i] or false end
  local function notifyInventory()
   local event=b.inv.changed
   assert(typeof(event)=='Instance' and event:IsA('BindableEvent'),'Inventory.changed bukan BindableEvent')
   event:Fire()
  end
  local refreshed,problem=pcall(notifyInventory)
  if not refreshed then
   for i=1,3 do b.hotbar[i]=saved[i] or false end
   pcall(notifyInventory);error(problem)
  end
  end
  farmSlot=2;slotBox.Text='2'
  if farmId~=id then hitsPerTile=math.max(1,math.floor(item.hits));hitBox.Text=tostring(hitsPerTile) end
  farmId=id
  selectedLabel.Text=item.name;blockInfo.Text=string.format('%s | %s | %d hit',item.name,item.background and 'BG' or 'FG',hitsPerTile)
  return b,id
end
