task.spawn(function()while alive do task.wait(.03);if active and operation=='PNB' then
 f.Visible=false
 local ok,err=pcall(function()
  if not ensureHome()then return end
  local list={};for _,v in pairs(targets)do list[#list+1]=v end
  assert(#list>0,'Pilih minimal satu tile')
  table.sort(list,function(a,b)if a[2]==b[2]then return a[1]<b[1]else return a[2]<b[2]end end)
  if runMode~='BREAK' then ensureFarm(false) end
  autoPosition()
  local state=debug.getupvalues(positionReader)
