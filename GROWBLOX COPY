local function collectTiles(offsets,cycleHome,recoveryId,anyDrop)
 assert(operation=='PNB' or operation=='FACTORY','Auto collect hanya aktif untuk PnB/Pabrik')
 local u=debug.getupvalues(positionReader)
 local world=u[6]
 local startX,startY=cycleHome[1],cycleHome[2]
 local initialWorld=world.name
 local pendingDrops=0
 local function go(x,y)
  if not active or not alive then return false end
  return moveTo(x+.5,y+1,.3,6)
 end
 release()
 local pendingReason=''
 local ok,problem=pcall(function()
  assert(type(world.goTo)=='function','goTo tidak tersedia')
  if not waitFor(.03)then return end
  local dropList
  for _,fn in ipairs(getgc())do if type(fn)=='function' then
   local success,v=pcall(debug.getupvalues,fn)
   if success and v[2]==world and type(v[1])=='table' and type(v[3])=='number' and type(v[4])=='number' and type(v[5])=='number' and type(v[6])=='function'
