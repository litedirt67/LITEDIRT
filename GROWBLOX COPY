    if b.inv.selected==seedId then return true end
   end
   return true
  end
  local function plantAll()
   local planted={}
   if not equipSeed()then return nil end
   for i,c in ipairs(cells)do
    if not active or not alive then return nil end
    if tileAt(c.x,c.y)==0 then
     for attempt=1,3 do
      if farmBinding.inv:count(seedId)<=0 then break end
