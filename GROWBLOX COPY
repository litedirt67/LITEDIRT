 operation='CLEAR'
 local setup,problem=pcall(function()farmBinding=inventoryBinding();autoPosition();bindObservations();findGameFns()end)
 if not setup then clearStatus.Text=tostring(problem);return end
 active=true;hud.Visible=true;f.Visible=false
 status.Text='Mode: '..(GF.punch and 'pukul lewat fungsi game' or 'klik layar')
 local ok,err=pcall(function()
  local state=debug.getupvalues(positionReader)
  local world=state[6];local name=world.name;local db=farmBinding.db
  local function priorityCollect()return alive and active end
  if not priorityCollect()then return end
  state=debug.getupvalues(positionReader)
  local protected={}
  local function cellKey(x,y)return x..':'..y end
  for y=0,world.h-1 do
   if not active or not alive then return end
   local row=world.fg[y]
   if row then for x=0,world.w-1 do
    local id=row[x]or 0;local item=db[id];local itemName=type(item)=='table' and string.lower(item.name or '')or ''
    if id==6 or itemName=='white door' or itemName=='main door' then
     protected[cellKey(x,y)]=true
     protected[cellKey(x-1,y)]=true;protected[cellKey(x+1,y)]=true
     protected[cellKey(x,y+1)]=true
    end
    if id==242 or id==8 or (type(item)=='table' and item.lock)then protected[cellKey(x,y)]=true end
   end end
   if y%8==0 then task.wait()end
  end
  local function free(x,y)
   if x<0 or x>=world.w or y<0 or y>=world.h then return false end
   local row=world.fg[y];if not row then return false end
   local id=row[x]or 0
   if id==0 then return true end
   local item=db[id]
   return type(item)=='table' and item.solid==false and not item.hurts and not item.deadly
  end
  local walkStep,walkWait=.25,.05
  local function travel(goalX,goalY)
   if walkMode=='WALK' and OrigIsDown then
    local ok,why=Path.goCell(goalX,goalY,0,40,true)
    if ok then return true end
    return false,why or 'tidak ada jalan'
   end
   local now=debug.getupvalues(positionReader)
   local sx,sy=math.floor(now[7]),math.floor(now[8]-.01)
   if not free(goalX,goalY)then return false,'tile berdiri tidak kosong' end
   local startKey=cellKey(sx,sy)
   local root={x=sx,y=sy,key=startKey}
   local nodes={};local previous={[startKey]=false};local head=1;local goal
   if free(sx,sy)then nodes[#nodes+1]=root end
   for y=sy-2,sy+2 do for x=sx-2,sx+2 do
    local dx,dy=x+.5-now[7],y+1-now[8]
    local key=cellKey(x,y)
    if key~=startKey and dx*dx+dy*dy<=1.75*1.75 and free(x,y) and previous[key]==nil then
     previous[key]=root;nodes[#nodes+1]={x=x,y=y,key=key}
    end
   end end
   while head<=#nodes do
    if not active or not alive then return end
    local n=nodes[head];head=head+1
    if n.x==goalX and n.y==goalY then goal=n;break end
    for _,d in ipairs({{1,0},{-1,0},{0,-1},{0,1}})do
     local x,y=n.x+d[1],n.y+d[2];local k=cellKey(x,y)
     if previous[k]==nil and free(x,y)then
      previous[k]=n;nodes[#nodes+1]={x=x,y=y,key=k}
     end
    end
    if head%256==0 then task.wait()end
   end
   if not goal then return false,'rute tidak tersambung' end
   local route={};local node=goal
   while node and node.key~=startKey do table.insert(route,1,node);node=previous[node.key]end
   if #route==0 then route={goal}end
   for _,waypoint in ipairs(route)do
    local attempts=0
    while alive and active do
     if world.name~=name then return false,'world berubah' end
     local p=debug.getupvalues(positionReader)
     local dx,dy=waypoint.x+.5-p[7],waypoint.y+1-p[8]
     local distance=math.sqrt(dx*dx+dy*dy)
     if distance<.55 then break end
     attempts+=1;if attempts>20 then return false,'waypoint tidak tercapai' end
     if walkMode=='WALK' then
      if attempts>6 then return false,'jalan tertahan' end
      if not moveTo(waypoint.x+.5,waypoint.y+1,.3,3,1.0)then return false end
      continue
     end
     local ratio=math.min(1,walkStep/distance)
     local nx,ny=p[7]+dx*ratio,p[8]+dy*ratio
     local done,problem=false,nil
     task.spawn(function()local ok,err=pcall(world.goTo,nx-.5,ny-1);if not ok then problem=err end;done=true end)
     local deadline=os.clock()+2
     while not done and active and alive and os.clock()<deadline do task.wait(.01)end
     if not active or not alive then return end
     if not done or problem then return false,problem and tostring(problem)or 'goTo timeout' end
     if not waitFor(walkWait)then return end
    end
   end
   return active and alive
  end
  local function eligible(id)
   local item=db[id]
   return type(item)=='table' and type(item.hits)=='number' and item.hits>0 and item.atlas
    and (item.kind==nil or item.kind=='block') and not item.lock and not item.area and not item.door and not item.entrance
    and not item.vend and not item.display and not item.provider and not item.toggle
  end
  local function readTile(grid,x,y)local row=grid[y];return row and row[x]or 0 end
  local queue={}
  for y=0,world.h-1 do
   if not active or not alive then return end
   for x=0,world.w-1 do
    if not protected[cellKey(x,y)] and (eligible(readTile(world.fg,x,y))or eligible(readTile(world.bg,x,y)))then
     queue[#queue+1]={x=x,y=y,attempts=0,done=false}
    end
   end
   if y%8==0 then task.wait()end
  end
  assert(#queue>0,'Tidak ada foreground/background yang bisa di-clear')
  local fgCount,bgCount,completed=0,0,0
  local lastReason=''
  local rowRetries,rowProgress={},{}
  local function standFor(t,current)
   local dx,dy=t.x+.5-current[7],t.y+.5-(current[8]-.475)
   if math.abs(dx)<=2.0 and math.abs(dy)<=2.0 then return {stay=true,score=dx*dx+dy*dy}end
   local best
   for _,o in ipairs({{0,-1},{-1,0},{1,0},{0,1}})do
    local x,y=t.x+o[1],t.y+o[2]
    if free(x,y)then
     local sx,sy=x+.5-current[7],y+1-current[8]
     local score=sx*sx+sy*sy
     if not best or score<best.score then best={x=x,y=y,score=score}end
    end
   end
   return best
  end
  local function mayEdit(t)
   if not world.areas or type(world.areas.mayBuild)~='function'then return false end
   local done,allowed=false,false
   task.spawn(function()local ok,result=pcall(world.areas.mayBuild,world.lock,t.x,t.y);allowed=ok and result==true;done=true end)
   local deadline=os.clock()+1
   while not done and active and alive and os.clock()<deadline do task.wait(.01)end
   return done and allowed
  end
  local function clearLayer(t,grid,label)
   local id=readTile(grid,t.x,t.y)
   if id==0 then return true end
   if not eligible(id)then return false end
   local limit=math.min(150,math.max(1,db[id].hits)*3)
   for hit=1,limit do
    if not active or not alive then return false end
    if not ensureHand()then return false end
    if readTile(grid,t.x,t.y)==0 then break end
    status.Text=string.format('CLEAR %d/%d | (%d,%d) %s | hit %d',completed,#queue,t.x,t.y,label,hit)
    if not clearPunch(t.x,t.y)then return false end
   end
   local settleUntil=os.clock()+.8
   while readTile(grid,t.x,t.y)~=0 and os.clock()<settleUntil do
    if not waitFor(.05)then return false end
   end
   return readTile(grid,t.x,t.y)==0
  end
  while active and alive do
   if not priorityCollect()then return end
   assert(world.name==name,'World berubah')
   local current=debug.getupvalues(positionReader)
   local topRow
   for _,entry in ipairs(queue)do
    if not entry.done and (not topRow or entry.y<topRow)then topRow=entry.y end
   end
   local chosen,stand
   for _,t in ipairs(queue)do
    if not t.done and t.attempts<3 and not protected[cellKey(t.x,t.y)] and readTile(world.fg,t.x,t.y)==4 then
     local dx,dy=t.x+.5-current[7],t.y+.5-(current[8]-.475)
     if math.abs(dx)<=2.35 and math.abs(dy)<=2.35 then
      local score=dx*dx+dy*dy
      if not stand or score<stand.score then chosen=t;stand={stay=true,score=score,lava=true}end
     end
    end
   end
   if not chosen and clearMethod=='CLUSTER' and topRow then
    for i,t in ipairs(queue)do
     if not t.done and t.attempts<3 and t.y<=topRow+2 and math.abs(t.x+.5-current[7])<=6 then
      local candidate=standFor(t,current)
      if candidate and (not stand or candidate.score<stand.score)then chosen=t;stand=candidate end
     end
     if i%256==0 then task.wait()end
    end
   end
   if not chosen then
    local dir=(topRow or 0)%2==0 and 1 or -1
    local bestRank
    for i,t in ipairs(queue)do
     if not t.done and t.y==topRow and t.attempts<3 then
      local candidate=standFor(t,current)
      if candidate then
       local rank=candidate.score
       if clearMethod=='ULAR' and (t.x+.5-current[7])*dir<-1 then rank=rank+10000 end
       if not bestRank or rank<bestRank then chosen=t;stand=candidate;bestRank=rank end
      end
     end
     if i%256==0 then task.wait()end
    end
   end
   if not chosen then
    if not topRow then break end
    local progress=fgCount+bgCount
    if rowProgress[topRow]~=progress then rowRetries[topRow]=0;rowProgress[topRow]=progress end
    rowRetries[topRow]=(rowRetries[topRow]or 0)+1
    if rowRetries[topRow]<=3 then
     for _,entry in ipairs(queue)do
      if not entry.done and entry.y==topRow then
       if readTile(world.fg,entry.x,entry.y)==0 and readTile(world.bg,entry.x,entry.y)==0 then
        entry.done=true;completed=completed+1
       else entry.attempts=0 end
      end
     end
     if not waitFor(.35)then return end
     continue
    end
    break
   end
   local t=chosen;t.attempts=t.attempts+1;punchReason=''
   if protected[cellKey(t.x,t.y)] or not mayEdit(t)then t.done=true
   else
     local reached,reason=true,nil
     if not stand.stay then
      reached,reason=travel(stand.x,stand.y)
     end
     if not active or not alive then return end
     if reached then
      if not ensureHand()then return end
      local fgBefore=readTile(world.fg,t.x,t.y)
      local fgDone=clearLayer(t,world.fg,'FG')
      if not active or not alive then return end
      if fgBefore~=0 and fgDone then fgCount=fgCount+1 end
      if fgDone and readTile(world.fg,t.x,t.y)==0 then
       local bgBefore=readTile(world.bg,t.x,t.y)
       local bgDone=clearLayer(t,world.bg,'BG')
       if not active or not alive then return end
       if bgBefore~=0 and bgDone then bgCount=bgCount+1 end
       if bgDone then
        t.done=true;completed=completed+1
        if not priorityCollect()then return end
       end
      end
     end
    end
   end
   stop(string.format('CLEAR Selesai: FG %d, BG %d, selesai %d/%d',fgCount,bgCount,completed,#queue))
  end)
  release();if not ok then stop('OFF - '..tostring(err))end
end

local function executeFactory()
 operation='FACTORY'
 local tb=U:GetFocusedTextBox();if tb then tb:ReleaseFocus() end
 local setup,problem=pcall(function()
  assert(FA.seedId,'Pilih seed dahulu')
  assert(next(FA.targets),'Pilih tile di grid Pabrik dahulu')
  farmBinding=inventoryBinding();farmBinding.gui=P.PlayerGui:FindFirstChild('InventoryGui')
  bindObservations();autoPosition();findGameFns()
 end)
 if not setup then FA.status.Text='OFF - '..tostring(problem);operation='PNB';return end
 local growSeconds=math.max(1,tonumber(FA.grow.Text) or 60)
 local maxCycles=math.max(0,math.floor(tonumber(FA.cycles.Text) or 0))
 local hitLimit=math.floor(tonumber(FA.hits.Text) or 0)
 if hitLimit<1 then hitLimit=150 end
 hitLimit=math.min(150,hitLimit)
 active=true;hud.Visible=true;f.Visible=false
 status.Text='Mode: '..((GF.punch and GF.setTile) and 'fungsi game' or 'klik layar')
 local ok,err=pcall(function()
  local seedId=FA.seedId
  local state=debug.getupvalues(positionReader)
  local world=state[6];local name=world.name
  farmHome={state[7],state[8],name=name}
  observed.worldName=name
  local baseX,baseY=math.floor(state[7]),math.floor(state[8]-.475)
  local offsets={}
  for _,v in pairs(FA.targets)do offsets[#offsets+1]=v end
  table.sort(offsets,function(a,b)if a[2]==b[2]then return a[1]<b[1]else return a[2]<b[2]end end)
  local cells,kept={},{}
  for _,o in ipairs(offsets)do
   local x,y=baseX+o[1],baseY+o[2]
   if x>=0 and x<world.w and y>=0 and y<world.h then cells[#cells+1]={x=x,y=y};kept[#kept+1]=o end
  end
  assert(#cells>0,'Semua tile di luar world')
  local function tileAt(x,y)local row=world.fg[y];return row and row[x] or 0 end
  local function equipSeed()
   local b=farmBinding
   assert(b.inv:count(seedId)>0,'Stok seed habis')
   if b.hotbar[1]~=seedId then
    local saved={b.hotbar[1],b.hotbar[2],b.hotbar[3]}
    local replacement={seedId}
    for i=1,3 do local v=saved[i];if v and v~=seedId and not table.find(replacement,v)then replacement[#replacement+1]=v end end
    for i=1,3 do b.hotbar[i]=replacement[i] or false end
    local ev=b.inv.changed
    assert(typeof(ev)=='Instance' and ev:IsA('BindableEvent'),'Inventory.changed bukan BindableEvent')
    ev:Fire()
   end
   for attempt=1,3 do
    key(Enum.KeyCode.Two)
    if not waitFor(.12)then return false end
    if b.inv.selected==seedId then return true end
   end
   return true
  end
  local function plantAll()
   local planted={}
   if not equipSeed()then return nil end
   for i,c in ipairs(cells)do
    if not active or not alive then return nil end
    if tileAt(c.x,c.y)==0 then
     for attempt=1,3 do
      if farmBinding.inv:count(seedId)<=0 then break end
      if farmBinding.inv.selected~=seedId then key(Enum.KeyCode.Two);if not waitFor(.1)then return nil end end
      local stockBefore=farmBinding.inv:count(seedId)
      local direct=GF.setTile~=nil
      if direct then
       if not directAct('place',c.x,c.y,seedId,'fg') then return nil end
      else
       clearPunch(c.x,c.y)
      end
      if not active or not alive then return nil end
      local untilT=os.clock()+.8
      while tileAt(c.x,c.y)==0 and (direct or farmBinding.inv:count(seedId)>=stockBefore) and os.clock()<untilT do
       if not waitFor(.05)then return nil end
      end
      if tileAt(c.x,c.y)~=0 or (not direct and farmBinding.inv:count(seedId)<stockBefore) then
       local settle=os.clock()+.3
       while tileAt(c.x,c.y)==0 and os.clock()<settle do if not waitFor(.05)then return nil end end
       planted[#planted+1]={x=c.x,y=c.y,id=tileAt(c.x,c.y)}
       break
      end
     end
    end
   end
   return planted
  end
  local function waitGrow(seconds)
   local untilT=os.clock()+seconds
   while os.clock()<untilT do
    assert(world.name==name,'World berubah')
    if not waitFor(.25)then return false end
   end
   return true
  end
  local function harvestAll(planted)
   local broken=0
   for i,c in ipairs(planted)do
    if c.id~=0 then
     local hits,fails=0,0
     while tileAt(c.x,c.y)==c.id and hits<hitLimit and fails<3 do
      if not active or not alive then return false end
      if not ensureHand()then return false end
      hits=hits+1
      if not clearPunch(c.x,c.y)then
       if not active or not alive then return false end
       fails=fails+1
      else fails=0 end
     end
     if tileAt(c.x,c.y)~=c.id then broken=broken+1 end
    end
   end
   return true,broken
  end
  local cycle,total=0,0
  while active and alive do
   assert(world.name==name,'World berubah')
   local planted=plantAll()
   if not planted then return end
   if #planted==0 then stop('OFF - tidak ada seed yang berhasil ditanam.');return end
   if not waitGrow(growSeconds)then return end
   local done,broken=harvestAll(planted)
   if not done then return end
   total=total+(broken or 0)
   collectTiles(kept,farmHome,nil,true)
   if not active or not alive then return end
   cycle=cycle+1;cycleCount=cycleCount+1;updateHud()
   if maxCycles>0 and cycle>=maxCycles then break end
  end
  stop(string.format('PABRIK selesai: %d siklus',cycle))
 end)
 release();if not ok then stop('OFF - '..tostring(err))end
end

