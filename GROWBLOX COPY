  local points,validOffsets={},{}
  for _,offset in ipairs(list)do
   local x,y=baseX+offset[1],baseY+offset[2]
   if x>=0 and x<world.w and y>=0 and y<world.h then
    points[#points+1]={x=x,y=y}
    validOffsets[#validOffsets+1]=offset
   end
  end
  assert(#points>0,'Semua target di luar world')
  local function screenPoint(target)
   autoPosition()
   local current=debug.getupvalues(positionReader)
   assert(current[6].name==cycleWorldName,'World berubah')
   local x,y=math.floor(current[7]),math.floor(current[8]-.475)
   local p=origin+Vector2.new((target.x-x)*step,(target.y-y)*step)
   local viewport=workspace.CurrentCamera.ViewportSize
   assert(p.X>0 and p.Y>60 and p.X<viewport.X and p.Y<viewport.Y-120,'Target keluar layar')
   return p
  end
  local phases={}
  if runMode~='BREAK' then phases[#phases+1]={slotKeys[farmSlot],1,'PUT'} end
  if runMode~='PUT' then phases[#phases+1]={Enum.KeyCode.One,hitsPerTile,'BREAK'} end
  for _,phase in ipairs(phases)do
   if not active or not alive then return end
   if phase[3]=='BREAK' then if not ensureHand()then return end else key(phase[1])end
   local switchDelay=(runMode=='BOTH' and phase[3]=='BREAK') and .31 or .05
   if not waitFor(switchDelay)then return end
   local pendingPut={}
   for index,target in ipairs(points)do
    if not active or not alive then return end
    if phase[3]=='PUT' then
     if runMode~='BREAK' then ensureFarm(false) end
     if not active or not alive then return end
     if farmBinding.inv.selected~=farmId then key(slotKeys[farmSlot]);if not waitFor(.08)then return end end
    end
    local item=farmBinding and farmBinding.db[farmId]
    local layer=(item and item.background) and 2 or 1
    local grid=layer==2 and world.bg or world.fg
    local function tileId()local row=grid[target.y];return row and row[target.x] or 0 end
    local desired=phase[3]=='PUT' and farmId or 0
    local blockedBG=layer==2 and world.fg[target.y] and (world.fg[target.y][target.x] or 0)~=0
    local existing=tileId()
    local differentFarmBlock=runMode=='BOTH' and phase[3]=='BREAK' and existing~=0 and existing~=farmId
    if not blockedBG and not differentFarmBlock and (phase[3]=='BREAK' or existing==0 or existing==desired) then
     local ackKey
     assert(type(observed.worldTag)=='function','worldTag tidak tersedia')
     ackKey=tostring(observed.worldTag(world.name))..':'..layer..':'..target.x..':'..target.y
     local began=os.clock()
     local stockBefore=farmBinding and farmId and farmBinding.inv:count(farmId) or nil
     local verification='server'
     local attempts=0
     local confirmed=existing==desired
     if phase[3]=='PUT' then
      if existing~=desired then
       status.Text=string.format('PUT %d/%d',index,#points)
       if GF.setTile then if not directAct('place',target.x,target.y,farmId,layer==2 and 'bg' or 'fg') then return end elseif not hold(screenPoint(target),.03)then return end
      end
      pendingPut[#pendingPut+1]={target=target,grid=grid,id=desired}
      confirmed=true;verification='menunggu batch'
     else
     while alive and active and not confirmed and attempts<3 do
      attempts=attempts+1
      local clicks=phase[3]=='PUT' and 1 or phase[2]
      for hit=1,clicks do
       if tileId()==desired and hit>1 then break end
       if GF.punch then if not directAct('punch',target.x,target.y) then return end elseif not hold(screenPoint(target),.03) then return end
      end
      local deadline=os.clock()+1.5
      local stableSince
      while alive and active and os.clock()<deadline do
       local ack=ackKey and observed.tiles[ackKey]
       confirmed=ack and ack.time>=began and ack.id==desired and tileId()==desired
       if not confirmed then
        local matches=tileId()==desired
        local stock=farmBinding and farmId and farmBinding.inv:count(farmId) or nil
        local stockChanged=stockBefore~=nil and stock~=nil and stock<stockBefore
        local localEvidence=matches
        if matches and localEvidence then
         stableSince=stableSince or os.clock()
         local settle=phase[3]=='PUT' and not stockChanged and .35 or (phase[3]=='BREAK' and .12 or .25)
         if os.clock()-stableSince>=settle then
          confirmed=true;verification='lokal'
         end
        else stableSince=nil end
       end
       if confirmed then break end
       if not waitFor(.05)then return end
      end
     end
     end
     if not alive or not active then return end
     local lastAck=observed.tiles[ackKey]
     assert(confirmed,string.format('%s (%d,%d) gagal konfirmasi',phase[3],target.x,target.y))
    end
   end
   if phase[3]=='PUT' and #pendingPut>0 then
    status.Text='PUT - memeriksa seluruh tile'
    if not waitFor(.16)then return end
    for _,entry in ipairs(pendingPut)do
     local target=entry.target
     local function placed()local row=entry.grid[target.y];return row and row[target.x]==entry.id end
     local retries=0
     while alive and active and not placed() and retries<2 do
      retries=retries+1
      if GF.setTile then if not directAct('place',target.x,target.y,entry.id,entry.grid==world.bg and 'bg' or 'fg') or not waitFor(.2)then return end elseif not hold(screenPoint(target),.03)or not waitFor(.2)then return end
     end
     if not alive or not active then return end
     assert(placed(),string.format('PUT (%d,%d) belum cocok',target.x,target.y))
    end
