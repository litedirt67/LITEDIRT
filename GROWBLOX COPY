  end
  local function wanted(d)
   if type(d)~='table' or not d.uid or type(d.x)~='number' or type(d.y)~='number' or d.display then return false end
   if anyDrop then return math.abs(d.x-startX)<=8 and d.y>=startY-4 and d.y<=math.min(world.h,startY+12) end
   if recoveryId then
    return d.id==recoveryId and math.abs(d.x-startX)<=8 and d.y>=startY-4 and d.y<=math.min(world.h,startY+12)
   end
   local key=math.floor(d.x)..':'..math.floor(d.y)
   return selectedCells[key]==true and (d.id==farmId or d.id==farmId+1 or d.id==112)
  end
  local function find(uid)
   for _,d in pairs(dropList)do if type(d)=='table' and d.uid==uid then return d end end
  end
  local function scan()
   local list,seen={},{}
   for _,d in pairs(dropList)do if wanted(d) and not seen[d.uid]then list[#list+1]=d;seen[d.uid]=true end end
   table.sort(list,function(a,b)if a.y==b.y then return a.x<b.x else return a.y<b.y end end)
   return list
  end
  for pass=1,2 do
   if recoveryId and farmBinding.inv:count(recoveryId)>0 then return end
   if not active or not alive then return end
   local drops=scan()
   if #drops==0 then pendingDrops=0;return end
   local rows,rowOrder={},{}
   for _,drop in ipairs(drops)do
    local row=math.floor(drop.y)
    if not rows[row]then rows[row]={};rowOrder[#rowOrder+1]=row end
    rows[row][#rows[row]+1]=drop
   end
   table.sort(rowOrder)
   local ordered={}
   for rowIndex,row in ipairs(rowOrder)do
    local leftToRight=rowIndex%2==1
    table.sort(rows[row],function(a,b)
     if a.x==b.x then return tostring(a.uid)<tostring(b.uid) end
     if leftToRight then return a.x<b.x end
     return a.x>b.x
    end)
    for _,drop in ipairs(rows[row])do ordered[#ordered+1]=drop end
   end
   drops=ordered
   local index=0
   while #drops>0 do
    local snapshot=table.remove(drops,1)
    index=index+1
    if recoveryId and farmBinding.inv:count(recoveryId)>0 then break end
    if not active or not alive then return end
    assert(world.name==initialWorld,'World berubah saat collect')
    local d=find(snapshot.uid)
    if d and not wanted(d)then d=nil end
    if d then
     local full=d.id~=112 and type(farmBinding.inv.room)=='function' and farmBinding.inv:room(d.id)<=0
     if full then
      pendingReason='inventory penuh'
     else
      d=find(snapshot.uid)
      if d and not wanted(d)then d=nil end
      if d then
       local retryDelay=d.refused and math.max(0,1.1-(os.clock()-d.refused)) or 0
       if retryDelay>0 and not waitFor(retryDelay)then return end
       d=find(snapshot.uid)
       if d and not wanted(d)then d=nil end
       if d then
        status.Text=string.format('COLLECT - %d | tersisa %d',index,#drops)
        local countBefore=d.n or 0
        local ackBefore=observed.pickupPositive
        local inventoryBefore=farmBinding.inv:count(d.id)
        local targetX,targetY=d.x,d.y
        if not (active and alive and moveTo(targetX,targetY+.5,.35,6,1.2))then return end
        local deadline=os.clock()+.85
        while active and alive and os.clock()<deadline do
         local current=find(snapshot.uid)
         local inventoryNow=farmBinding.inv:count(d.id)
         if inventoryNow>inventoryBefore or (observed.pickupPositive>ackBefore and (not current or (current.n or 0)<countBefore)) then break end
         if not current and os.clock()>deadline-.65 then break end
         if current and current.refused and os.clock()-current.refused<.3 then pendingReason='pickup ditolak';break end
         if not waitFor(.03)then return end
        end
        local remaining=find(snapshot.uid)
        if remaining and (remaining.n or 0)>=countBefore then
         local position=debug.getupvalues(positionReader)
         if math.abs(position[7]-remaining.x)>.6 or position[8]<remaining.y-.3 or position[8]>remaining.y+1.25 then
          pendingReason='posisi bergeser dari drop'
         elseif pendingReason=='' then pendingReason='menunggu konfirmasi pickup' end
        end
       end
      end
     end
    end
   end
   pendingDrops=#scan()
   if pendingDrops==0 then return end
   if pass<2 and not waitFor(.12)then return end
  end
  pendingDrops=#scan()
 end)
 if alive and active then
  local attempt=0
  local stable=false
  while alive and active and not stable do
   if world.name~=initialWorld then stop('OFF - world berubah saat kembali');return end
   attempt=attempt+1
   status.Text=string.format('KEMBALI - percobaan %d | F8 membatalkan',attempt)
   local returned,returnError=pcall(function()
    if not go(startX-.5,startY-1) then return false end
    for sample=1,3 do
     if not waitFor(.1)then return false end
     local current=debug.getupvalues(positionReader)
     if current[6].name~=initialWorld or math.abs(current[7]-startX)>.35 or math.abs(current[8]-startY)>.45 then return false end
    end
    return true
   end)
   stable=returned and returnError==true
   if not alive or not active then return end
   if not stable then
    status.Text=string.format('KEMBALI belum berhasil (%d) - mencoba lagi...',attempt)
    if not waitFor(math.min(.25+attempt*.15,1.2))then return end
   end
  end
 end
 if alive and active and not ok then stop('OFF - '..tostring(problem));return end
 if alive and active and pendingDrops>0 then
  status.Text=string.format('ON - %d drop tertunda (%s); coba lagi siklus berikutnya',pendingDrops,pendingReason)
  waitFor(.3)
 end
