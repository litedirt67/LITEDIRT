            if ok and u[1] == Players and type(u[6]) == 'table' and type(u[6].fg) == 'table' and type(u[6].bg) == 'table'
                and type(u[2]) == 'number' and type(u[4]) == 'number' and type(u[5]) == 'number' and type(u[7]) == 'number' and type(u[8]) == 'number'
                and type(u[14]) == 'table' and type(u[14].select) == 'function' and type(u[35]) == 'function' then
                positionReader = fn; break
            end
        end end
    end
    assert(positionReader, 'Game.act tidak ditemukan')
    local u = debug.getupvalues(positionReader)
    local gg = P.PlayerGui:FindFirstChild('GameGui'); local w = gg and gg:FindFirstChild('World'); local c = w and w:FindFirstChild('Camera')
    assert(c, 'Camera GUI tidak ditemukan')
    local uiScale = c:FindFirstChildOfClass('UIScale')
    local scale = uiScale and uiScale.Scale or 1
    step = u[4] * scale
    local inset = game:GetService('GuiService'):GetGuiInset()
    local viewport = workspace.CurrentCamera.ViewportSize
    local key = string.format('%.5f:%d:%d:%.1f:%.1f', step, viewport.X, viewport.Y, inset.X, inset.Y)
    if pointerGeometryKey ~= key then pointerGeometryKey = key; pointerCorrection = Vector2.zero end
    local px, py = math.floor(u[7]), math.floor(u[8] - .475)
    origin = w.AbsolutePosition + inset + pointerCorrection + Vector2.new((px + .5 - u[2]) * step, (py + .5 - u[5]) * step)
end

