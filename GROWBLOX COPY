local observed = {tiles={}, pickupSerial=0, pickupPositive=0}
local function bindObservations()
    local ns
    for _, value in ipairs(getgc(true)) do
        if type(value) == 'table' then
            local took = rawget(value, 'took'); local tile = rawget(value, 'tileChanged')
            if type(took) == 'table' and type(tile) == 'table' and type(took.listen) == 'function' and type(tile.listen) == 'function'
                and type(rawget(value, 'take')) == 'table' and type(rawget(value, 'move')) == 'table' and type(rawget(value, 'worldTag')) == 'function' then ns = value; break end
        end
    end
    assert(ns, 'Tidak dapat membaca packet took/tileChanged')
    local env = type(getgenv) == 'function' and getgenv() or _G
    local registry = env.__KENCOT_PACKET_OBSERVER
    if not registry or registry.namespace ~= ns then
        registry = {namespace = ns}
        env.__KENCOT_PACKET_OBSERVER = registry
        ns.took.listen(function(packet)
            local target = registry.target
            if not target then return end
            target.pickupSerial = target.pickupSerial + 1
            if type(packet.got) == 'number' and packet.got > 0 then target.pickupPositive = target.pickupPositive + packet.got end
        end)
        ns.tileChanged.listen(function(packet)
            local target = registry.target
            if target then target.tiles[tostring(packet.w)..':'..packet.layer..':'..packet.x..':'..packet.y] = {id = packet.id, time = os.clock()} end
        end)
    end
    registry.target = observed
    observed.worldTag = ns.worldTag
end

