-- Pathfinder A* (Diringkas dan dimasukkan agar jalan normal)
local Path = {Bad={}}
do
    local floor, abs = math.floor, math.abs
    local function fgId(w,x,y) local r = w.fg[y]; return (r and r[x]) or 0 end
    local function item(w,x,y) local id = fgId(w,x,y); return id ~= 0 and ItemDB[id] or nil end
    local function solid(w,x,y)
        if x < 0 or x >= w.w or y >= w.h then return true end
        if y < 0 then return false end
        local it = item(w,x,y)
        return it ~= nil and it.solid == true
    end
    local function hazard(w,x,y) local it = item(w,x,y); return it ~= nil and (it.deadly or it.hurts or it.laser) and true or false end
    local function plat(w,x,y) local it = item(w,x,y); return it ~= nil and it.platform and true or false end
    local function open(w,x,y) return not solid(w,x,y) and not hazard(w,x,y) end
    local function support(w,x,y) return not hazard(w,x,y+1) and (solid(w,x,y+1) or plat(w,x,y+1)) end
    local function startNode(w,x,y)
        local nx, ny = floor(x), floor(y-.475)
        if support(w, nx, ny) then return nx, ny end
        for _, c in ipairs({floor(x-.3), floor(x+.3-.0001)}) do
            if c ~= nx and support(w, c, ny) then return c, ny end
        end
        return nx, ny
    end
    local function astar(w, sx, sy, gx, gy, radius)
        local W, H = w.w, w.h
        local N = W * H
        local openC, supC = {}, {}
        local function op(x, y)
            if x < 0 or x >= W or y >= H then return false end
            if y < 0 then return true end
            local k = y * W + x; local v = openC[k]
            if v == nil then v = open(w, x, y); openC[k] = v end
            return v
        end
        local function sup(x, y)
            if x < 0 or x >= W or y < 0 or y >= H then return false end
            local k = y * W + x; local v = supC[k]
            if v == nil then v = support(w, x, y); supC[k] = v end
            return v
        end
        local hf, hi, hn = {}, {}, 0
        local function push(f, i)
            hn += 1; local k = hn
            while k > 1 do
                local p = k // 2
                if hf[p] <= f then break end
                hf[k], hi[k] = hf[p], hi[p]; k = p
            end
            hf[k], hi[k] = f, i
        end
        local function pop()
            local top = hi[1]
            local lf, li = hf[hn], hi[hn]
            hf[hn], hi[hn] = nil, nil; hn -= 1
            if hn > 0 then
                local k = 1
                while true do
                    local c = k * 2
                    if c > hn then break end
                    if c < hn and hf[c+1] < hf[c] then c += 1 end
                    if lf <= hf[c] then break end
                    hf[k], hi[k] = hf[c], hi[c]; k = c
                end
                hf[k], hi[k] = lf, li
            end
            return top
        end
        local start = sy * W + sx
        local g, came, kind, closed = {[start]=0}, {}, {}, {}
        push(abs(gx-sx)+abs(gy-sy), start)
        local now = os.clock()
        local expanded = 0
        while hn > 0 do
            local cur = pop()
            if not closed[cur] then
                closed[cur] = true
                local cx, cy = cur % W, cur // W
                if abs(cx-gx) + abs(cy-gy) <= radius then
                    local out, i = {}, cur
                    while i ~= start do
                        local p = came[i]
                        table.insert(out, 1, {fx=p%W, fy=p//W, x=i%W, y=i//W, kind=kind[i], key=p*N+i})
                        i = p
                    end
                    return out
                end
                expanded += 1
                if expanded > 12000 then return nil end
                if expanded % 300 == 0 then task.wait(); if not (alive and active) then return nil end end
                local gc = g[cur]
                local function add(nx, ny, k, cost)
                    local ni = ny * W + nx
                    if closed[ni] then return end
                    local bad = Path.Bad[cur * N + ni]
                    if bad and bad > now then return end
                    local ng = gc + cost
                    local old = g[ni]
                    if old == nil or ng < old then
                        g[ni], came[ni], kind[ni] = ng, cur, k
                        push(ng + abs(gx-nx) + abs(gy-ny)*1.2, ni)
                    end
                end
                for s = -1, 1, 2 do
                    local ax = cx + s
                    if op(ax, cy) then
                        if sup(ax, cy) then
                            add(ax, cy, 'walk', 1)
                        else
                            local fy = cy + 1
                            while fy < H and fy - cy <= 30 and op(ax, fy) and not sup(ax, fy) do fy += 1 end
                            if fy < H and op(ax, fy) and sup(ax, fy) then add(ax, fy, 'fall', 1 + .5*(fy-cy)) end
                            if op(cx, cy-1) then
                                for dist = 2, 3 do
                                    local lx = cx + dist * s
                                    local clear = true
                                    for j = 1, dist-1 do
                                        local mx = cx + j * s
                                        if not (op(mx, cy) and op(mx, cy-1)) then clear = false; break end
                                    end
                                    if not clear then break end
                                    if op(lx, cy) and op(lx, cy-1) and sup(lx, cy) then add(lx, cy, 'gap', dist + .5) end
                                end
                            end
                        end
                    end
                    for dy = 1, 3 do
                        if not op(cx, cy-dy) then break end
                        if op(cx, cy-dy-1) and op(ax, cy-dy) and op(ax, cy-dy-1) and sup(ax, cy-dy) then
                            add(ax, cy-dy, 'jump', 1 + 1.5*dy)
                        end
                    end
                end
            end
        end
        return nil
    end
    local function sample()
        local u = debug.getupvalues(positionReader)
        local w = u[6]
        local now = os.clock()
        local s = {x=u[7], y=u[8], w=w, vx=0, vy=0}
        local p = Path.prev
        if p then
            local dt = now - p.t
            if dt >= .012 then
                s.vx, s.vy = (s.x-p.x)/dt, (s.y-p.y)/dt
                Path.prev = {x=s.x, y=s.y, t=now, vx=s.vx, vy=s.vy}
            else
                s.vx, s.vy = p.vx or 0, p.vy or 0
            end
        else
            Path.prev = {x=s.x, y=s.y, t=now, vx=0, vy=0}
        end
        local ry = floor(s.y + .01)
        local near = abs(s.y - floor(s.y+.5)) < .04
        local function sp(cx) return solid(w, cx, ry) or plat(w, cx, ry) end
        s.grounded = near and abs(s.vy) < 1.5 and (sp(floor(s.x-.3)) or sp(floor(s.x+.3-.0001)))
        return s
    end
    local function tick() task.wait(); return alive and active end
    local function releasePath() AutoInput.left = false; AutoInput.right = false; AutoInput.jump = false end
    local function steer(s, tx, tol)
        local dx = tx - s.x
        local dir = 0
        if abs(dx) > tol then
            dir = dx > 0 and 1 or -1
            local decel = s.grounded and 45 or 16
            if s.vx * dir > 0 and s.vx * s.vx / (2 * decel) >= abs(dx) - tol*.5 then dir = 0 end
        end
        AutoInput.active = true
        AutoInput.left = dir < 0; AutoInput.right = dir > 0
    end
    local function execWalk(tx, ty)
        local cx = tx + .5
        local t0 = os.clock()
        local limit = 1.5 + abs(cx - sample().x) * .35
        while tick() do
            local s = sample()
            steer(s, cx, .1)
            local nx, ny = floor(s.x), floor(s.y-.475)
            if s.grounded and ny ~= ty then return false end
            if nx == tx and abs(s.x-cx) <= .2 and s.grounded and abs(s.vx) < 2 then releasePath(); return true end
            if os.clock() - t0 > limit then return false end
        end
        return false
    end
    local function execFall(e)
        local cx = e.x + .5
        local t0 = os.clock()
        local limit = 1.5 + .3*(e.y - e.fy)
        while tick() do
            local s = sample()
            steer(s, cx, .1)
            if s.grounded then
                local nx, ny = floor(s.x), floor(s.y-.475)
                if ny == e.y then
                    if nx == e.x and abs(s.x-cx) <= .25 then releasePath(); return true end
                elseif ny ~= e.fy then
                    return false
                end
            end
            if os.clock() - t0 > limit then return false end
        end
        return false
    end
    local function execJump(e)
        if not execWalk(e.fx, e.fy) then return false end
        local dy = e.fy - e.y
        local top = e.y + 1
        local releaseY = top - ((dy == 1) and 0 or .4)
        local cx = e.x + .5
        releasePath()
        if not tick() then return false end
        AutoInput.jump = true
        local t0 = os.clock()
        local air = false
        while tick() do
            local s = sample()
            if not s.grounded then air = true end
            if AutoInput.jump and (s.y <= releaseY or (air and s.vy >= 0)) then AutoInput.jump = false end
            if s.y <= top + .25 then steer(s, cx, .1) else steer(s, e.fx+.5, .15) end
            if air and s.grounded then
                local nx, ny = floor(s.x), floor(s.y-.475)
                if ny == e.y then
                    if nx == e.x and abs(s.x-cx) <= .25 then AutoInput.jump = false; releasePath(); return true end
                else
                    AutoInput.jump = false; return false
                end
            end
            if not air and os.clock() - t0 > .35 then AutoInput.jump = false; return false end
            if os.clock() - t0 > 1.8 then AutoInput.jump = false; return false end
        end
        AutoInput.jump = false
        return false
    end
    local function execGap(e)
        if not execWalk(e.fx, e.fy) then return false end
        local dir = (e.x > e.fx) and 1 or -1
        local takeoff = e.fx + .5 + dir * .6
        local startY = sample().y
        local cx = e.x + .5
        releasePath()
        local t0 = os.clock()
        local jumped, air, jumpAt = false, false, 0
        while tick() do
            local s = sample()
            if not jumped then
                AutoInput.left = dir < 0; AutoInput.right = dir > 0
                if (s.x - takeoff) * dir >= 0 or not s.grounded then jumped, jumpAt = true, os.clock(); AutoInput.jump = s.grounded end
            else
                if not s.grounded then air = true end
                if AutoInput.jump and (s.y <= startY - 1 or (air and s.vy >= 0)) then AutoInput.jump = false end
                steer(s, cx, .1)
                if air and s.grounded then
                    local nx, ny = floor(s.x), floor(s.y-.475)
                    if ny == e.y then
                        if nx == e.x and abs(s.x-cx) <= .25 then releasePath(); return true end
                    else
                        AutoInput.jump = false; return false
                    end
                end
                if not air and os.clock() - jumpAt > .35 then AutoInput.jump = false; return false end
            end
            if os.clock() - t0 > 2.2 then AutoInput.jump = false; return false end
        end
        AutoInput.jump = false
        return false
    end
    local function follow(route)
        local i = 1
        while i <= #route do
            if not (alive and active) then return false end
            local e = route[i]
            local last, ok = i, false
            if e.kind == 'walk' then
                local d = e.x - e.fx
                while route[last+1] and route[last+1].kind == 'walk' and (route[last+1].x - route[last+1].fx) == d do last += 1 end
                ok = execWalk(route[last].x, route[last].y)
            elseif e.kind == 'fall' then ok = execFall(e)
            elseif e.kind == 'jump' then ok = execJump(e)
            elseif e.kind == 'gap' then ok = execGap(e) end
            AutoInput.jump = false; releasePath()
            if not ok then Path.Bad[e.key] = os.clock() + 20; return false end
            i = last + 1
        end
        return true
    end
    function Path.goCell(gx, gy, radius, maxSec, strict)
        if not OrigIsDown then return false, 'kontrol game tidak ketemu' end
        radius = radius or 0
        local t0 = os.clock()
        maxSec = maxSec or 30
        local fails = 0
        local result, reason = false, 'waktu habis'
        AutoInput.active = true
        while alive and active and os.clock() - t0 < maxSec do
            local s = sample()
            local w = s.w
            if gx < 0 or gy < 0 or gx >= w.w or gy >= w.h then reason = 'tujuan di luar world'; break end
            local sx, sy = startNode(w, s.x, s.y)
            if abs(sx-gx) + abs(sy-gy) <= radius and s.grounded then result = true; break end
            local route = astar(w, sx, sy, gx, gy, radius)
            if not route and radius < 2 and not strict then route = astar(w, sx, sy, gx, gy, 2) end
            if not route then reason = 'tidak ada jalan'; break end
            if #route == 0 then result = true; break end
            if not follow(route) then
                fails += 1
                if fails >= 5 then reason = 'jalan tertahan'; break end
                task.wait(.1)
            end
        end
        releasePath(); AutoInput.active = false
        return result, reason
    end
end

local function moveTo(px, py, tol, timeout, dyTol)
    if walkMode == 'WALK' then
        if OrigIsDown then
            Path.goCell(math.floor(px), math.floor(py-.475), 0, math.max(timeout or 10, 10))
        end
        return true
    end
    local world = debug.getupvalues(positionReader)[6]
    local done, problem = false, nil
    task.spawn(function() local ok, err = pcall(world.goTo, px-.5, py-1); if not ok then problem = err end; done = true end)
    local deadline = os.clock() + 2
    while not done and active and alive and os.clock() < deadline do task.wait(.01) end
    return true
end

