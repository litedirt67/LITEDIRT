-- Fungsi Tombol Collapse (Minimize/Maximize UI)
local isCollapsed = false
CollapseBtn.MouseButton1Click:Connect(function()
    isCollapsed = not isCollapsed
    if isCollapsed then
        TextBox.Visible = false
        SubmitBtn.Visible = false
        GetKeyBtn.Visible = false
        MainFrame.Size = UDim2.new(0, 300, 0, 40)
        CollapseBtn.Text = "+"
    else
        TextBox.Visible = true
        SubmitBtn.Visible = true
        GetKeyBtn.Visible = true
        MainFrame.Size = UDim2.new(0, 300, 0, 210)
        CollapseBtn.Text = "-"
    end
end)

-- Fungsi Tombol Get Key (Menyalin link Discord ke Clipboard)
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(DISCORD_URL)
        GetKeyBtn.Text = "Link Discord Disalin!"
    else
        GetKeyBtn.Text = "Executor Tidak Support"
    end
    task.wait(1.5)
    GetKeyBtn.Text = "GET KEY (DISCORD)"
end)

-- Fungsi Validasi Key & Load Script GitHub
local function verifyAndLoad()
    local userKey = TextBox.Text
    if userKey == "" then 
        SubmitBtn.Text = "Key Kosong!"
        task.wait(1.5)
        SubmitBtn.Text = "VERIFY KEY"
        return
    end
    
    SubmitBtn.Text = "Checking..."
    local fullUrl = WEB_APP_URL .. "?key=" .. userKey
    
    local success, response = pcall(function()
        return game:HttpGet(fullUrl)
    end)
    
    if success then
        local result = response:gsub("%s+", "") 
        
        if result == "SUCCESS" then
            SubmitBtn.Text = "Key Benar! Memuat..."
            task.wait(1)
            ScreenGui:Destroy()
            
            -- Eksekusi script utama langsung dari GitHub kamu
            local loadSuccess, err = pcall(function()
                loadstring(game:HttpGet(GITHUB_SCRIPT_URL))()
            end)
            
            if not loadSuccess then
                warn("Gagal memuat script dari GitHub: " .. tostring(err))
            end
            
        else
            SubmitBtn.Text = "Key Salah!"
            task.wait(1.5)
            SubmitBtn.Text = "VERIFY KEY"
        end
    else
        SubmitBtn.Text = "Gagal Terhubung!"
        task.wait(1.5)
        SubmitBtn.Text = "VERIFY KEY"
    end
end

-- Tombol Verify diklik atau menekan tombol Enter di keyboard
SubmitBtn.MouseButton1Click:Connect(verifyAndLoad)
TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        verifyAndLoad()
    end
end)
