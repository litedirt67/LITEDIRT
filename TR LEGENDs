-- Konfigurasi Link & Script Utama
local WEB_APP_URL = "https://script.google.com/macros/s/AKfycbxCkY-i58Utj4zhZMQCZroayzrhET5AEnumgpEv0BFryMfq5yYadIlMZQ3SUgcQRhgkJA/exec"
local GITHUB_SCRIPT_URL = "https://raw.githubusercontent.com/litedirt67/LITEDIRT/refs/heads/TYSM/AUTO%20DELIVERY"
local DISCORD_URL = "https://discord.gg/ZuHqAq7h4"
local FILENAME = "DeltaKey_Auth.txt" -- Nama file lokal untuk menyimpan key

-- Fungsi untuk mengambil HWID
local function getHwid()
    local hwid = "UNKNOWN_HWID"
    local successHwid, errHwid = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientIdHash()
    end)
    if successHwid and errHwid then
        hwid = errHwid
    end
    return hwid
end

-- Fungsi untuk mengecek key langsung ke server (tanpa UI)
local function checkKeyOnline(userKey)
    local hwid = getHwid()
    local fullUrl = WEB_APP_URL .. "?key=" .. userKey .. "&hwid=" .. hwid
    
    local success, response = pcall(function()
        return game:HttpGet(fullUrl)
    end)
    
    if success then
        return response:gsub("%s+", "")
    end
    return "ERROR"
end

-- 1. CEK FILE LOKAL TERLEBIH DAHULU (Deteksi ke-2 dan seterusnya)
if writefile and readfile and isfile and isfile(FILENAME) then
    local savedKey = readfile(FILENAME)
    if savedKey and savedKey ~= "" then
        -- Validasi ulang key yang tersimpan ke server secara diam-diam
        local result = checkKeyOnline(savedKey)
        if result == "SUCCESS" then
            -- Jika masih valid, langsung jalankan script GitHub tanpa munculin GUI
            local loadSuccess, err = pcall(function()
                loadstring(game:HttpGet(GITHUB_SCRIPT_URL))()
            end)
            if loadSuccess then
                return -- Keluar dari script, tidak usah buat UI
            end
        else
            -- Jika file key ternyata sudah expired atau tidak valid, hapus filenya
            if delfile then
                pcall(function() delfile(FILENAME) end)
            end
        end
    end
end

