local function verifyAndLoad()
    local userKey = TextBox.Text
    if userKey == "" then 
        SubmitBtn.Text = "Key Kosong!"
        task.wait(1.5)
        SubmitBtn.Text = "VERIFY KEY"
        return
    end
    
    SubmitBtn.Text = "Checking..."
    local result = checkKeyOnline(userKey)
    
    if result == "SUCCESS" then
        SubmitBtn.Text = "Key Benar! Memuat..."
        
        -- Simpan key ke file lokal agar tidak perlu input lagi nanti
        if writefile then
            pcall(function()
                writefile(FILENAME, userKey)
            end)
        end
        
        task.wait(1)
        ScreenGui:Destroy()
        
        local loadSuccess, err = pcall(function()
            loadstring(game:HttpGet(GITHUB_SCRIPT_URL))()
        end)
        
        if not loadSuccess then
            warn("Gagal memuat script dari GitHub: " .. tostring(err))
        end
        
    elseif result == "EXPIRED" then
        SubmitBtn.Text = "Key Sudah Expired!"
        task.wait(1.5)
        SubmitBtn.Text = "VERIFY KEY"
        
    elseif result == "ALREADY_USED" then
        SubmitBtn.Text = "Key Dipakai Device Lain!"
        task.wait(1.5)
        SubmitBtn.Text = "VERIFY KEY"
        
    else
        SubmitBtn.Text = "Key Salah / Tidak Valid!"
        task.wait(1.5)
        SubmitBtn.Text = "VERIFY KEY"
    end
end

SubmitBtn.MouseButton1Click:Connect(verifyAndLoad)
TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        verifyAndLoad()
    end
end)
